/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run josenimo/histo -profile test_full,singularity --outdir <OUTDIR>

    PLACEHOLDER. This was a Visium HD profile inherited from nf-core/sopa, running
    Space Ranger, StarDist and Proseg against 10x test data. All of that is out of
    scope, so it has been emptied rather than adapted.

    Phase 6 rebuilds this around a real multiplex immunofluorescence dataset. Until
    then `-profile test_full` will fail for lack of an input, which is preferable to
    silently running against 10x lung cancer data.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name = 'Full test profile (placeholder)'
    config_profile_description = 'Not yet implemented; see Phase 6 in ROADMAP.md'

    // TODO Phase 6: point at a real mIF dataset in the test-data repository
    input = null

    // TODO Phase 6: when a real mIF dataset lands, this becomes a cycle
    // samplesheet and use_preprocessing goes back to true.
    use_preprocessing = false

    // Reader
    technology = "ome_tif"

    // Patches
    patch_width_pixel = 5000
    patch_overlap_pixel = 50

    // Cellpose segmentation
    use_cellpose = true
    cellpose_channels = 'DAPI'

    // Aggregation
    aggregate_channels = true
}
