/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SLURM execution
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Combine with a container profile and a size profile:

        -profile singularity,size_medium,slurm

    Without this profile the executor defaults to `local`, which means every task runs
    on the machine you launched from. On a login node that is antisocial at best. This
    file exists so that forgetting it is a config error rather than a silent mistake.

    Nextflow submits the jobs itself; you never write an sbatch script. Launch the
    pipeline from a long-lived session (tmux or screen) or submit the launcher itself
    as a small single-CPU job.
----------------------------------------------------------------------------------------
*/

process {
    executor = 'slurm'

    // No `queue` is set: the MDC default partition `normal` has a 7-day walltime,
    // which comfortably covers the longest request in conf/sizes.config (ASHLAR at
    // 72 h under size_huge, 144 h on its first retry). Longer partitions exist if a
    // single task ever needs more than seven days:
    //   normal  7 d (default)   high  28 d   long  62 d   gpu  14 d
    //   queue = 'long'

    // The floor of the cluster, not the ceiling, and deliberately so.
    //
    // `sinfo` reports `32+` CPUs and `176174+` MB, where the `+` means the smallest
    // node has at least that and some have more. Capping at the smallest guarantees
    // every task can be placed on any node in the partition rather than waiting for
    // one of the fat ones. 176174 MB is 172.04 GiB, so 172.GB is the safe rounding.
    //
    // Why this matters: resourceLimits caps a request instead of letting it through.
    // Without it, a task asking for more memory than any node has is not rejected by
    // SLURM, it simply queues forever, and you discover that days later.
    //
    // Consequence worth knowing: `memory * task.attempt` in conf/sizes.config stops
    // growing once it reaches this cap. ASHLAR under size_huge asks 150 GB, so its
    // retry asks 300 GB and receives 172 GB. That is still an increase, but a smaller
    // one than the doubling suggests. If ASHLAR OOMs twice at 172 GB, the answer is a
    // fat-node partition, not another retry.
    //
    //   sinfo -e -o "%10c %10m %N"    # per-configuration, to find the real ceiling
    resourceLimits = [
        cpus: 32,
        memory: 172.GB,
        time: 168.h,
    ]
}

executor {
    // Cap on jobs queued at once. Nextflow will happily submit a task per TMA core,
    // and a slide with 80 cores would put 80 jobs in the queue in one burst.
    queueSize = 50

    // Some schedulers rate-limit or simply fall over under rapid submission.
    submitRateLimit = '10/1min'
}

singularity {
    // TODO: bind mounts, if the cluster does not auto-mount your data filesystem.
    // Symptom of needing this is a task failing with "No such file or directory" on
    // an input path that plainly exists on the login node.
    //   runOptions = '--bind /fast,/scratch'
    //
    // NXF_SINGULARITY_CACHEDIR is deliberately NOT set here. It points at a shared
    // path and is configured in the environment, so that it is the same for every
    // pipeline rather than something each one redefines. See docs/containers.md.
    autoMounts = true
}
