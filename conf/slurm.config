/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SLURM execution
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Use as: -profile singularity,size_medium,slurm
    Launch from tmux or screen, or as a small single-CPU job; Nextflow submits the tasks.
----------------------------------------------------------------------------------------
*/

process {
    executor = 'slurm'

    // No queue: the MDC default `normal` (7 d) covers the longest request; set queue = 'long' (62 d) if needed.

    // Smallest MDC node (sinfo: 32+ CPUs, 176174+ MB), so every task fits any node instead of queueing forever.
    // Retries in conf/sizes.config stop growing at this cap; repeated ASHLAR OOMs need a fat-node partition.
    resourceLimits = [
        cpus: 32,
        memory: 172.GB,
        time: 168.h,
    ]
}

executor {
    // Avoids a burst of one job per TMA core.
    queueSize = 50

    // Some schedulers rate-limit or simply fall over under rapid submission.
    submitRateLimit = '10/1min'
}

singularity {
    // TODO: runOptions = '--bind /fast,/scratch' if tasks cannot see paths that exist on the login node.
    // NXF_SINGULARITY_CACHEDIR is set in the environment, not here (docs/containers.md).
    autoMounts = true
}
