/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Pre-release check 2 of 2: the TMA path on exemplar-002, with background subtraction
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Two cycles of a tissue microarray. Cycle 1 carries the markers and cycle 2 the
    autofluorescence channels they subtract, which is why these two cycles and not
    others: exemplar-002 is one of the few public datasets where the background
    channels are real rather than a marker relabelled to stand in for one.

    Covers what test_exemplar001 cannot: Coreograph dearraying a slide into cores,
    each core processed independently, background subtraction per core, the merge
    back into one store, and the slide-level QC report. Subtraction runs after
    dearray, so every core keeps an unsubtracted twin and the before-and-after
    comparison appears in each core's QC report.

        export HISTO_EXEMPLARS=/fast/AG_Coscia/$USER/HISTO/exemplars
        bash tools/fetch_exemplars.sh
        nf-test test tests/exemplar002.nf.test \
            --profile test_exemplar002,singularity,size_small,slurm

    Cluster only, for the reasons given in test_exemplar001.config, and more so:
    Coreograph's image alone is 5.9 GB on disk.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name = 'Exemplar-002, TMA with background subtraction'
    config_profile_description = 'Two cycles, dearrayed into cores, subtracted, merged per slide'

    input = "${System.getenv('HISTO_EXEMPLARS') ?: 'HISTO_EXEMPLARS_IS_NOT_SET'}/samplesheet_exemplar002.csv"

    use_preprocessing = true
    technology = "ome_tif"

    use_backsub = true
    backsub_args = ''

    use_tma_dearray = true
    // downsampleFactor 4 is what a 4.1 x 4.1 mm array of roughly 2 mm cores needs
    // for Coreograph's UNet to see them at the scale it expects. channel 0 is the
    // nuclear stain, which has no background assigned and so is identical before
    // and after subtraction -- detection is unaffected by where subtraction runs.
    coreograph_args = '--downsampleFactor 4 --channel 0 --buffer 2'

    use_cellpose = true
    cellpose_channels = "DNA_1"
    cellpose_diameter = 35

    // Cores are about 2900 x 2900, so 2000 gives 2 x 2 patches per core: tiled,
    // without splitting a core so finely that the run is mostly overhead.
    patch_width_pixel = 2000
    patch_overlap_pixel = 50

    aggregate_channels = true
}
