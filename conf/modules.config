/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: BASICPY {
        // One task per cycle; without the cycle number every cycle writes the same names.
        tag = { "${meta.id}_cycle${meta.cycle_number}" }
        ext.prefix = { "${meta.id}_cycle${meta.cycle_number}" }
        publishDir = [
            path: { "${params.outdir}/preprocessing/illumination" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: ASHLAR {
        ext.args = params.ashlar_args
        publishDir = [
            path: { "${params.outdir}/preprocessing/registration" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: BACKSUB {
        ext.args = params.backsub_args
        // Required: without a distinct prefix the output takes the input's name and fails as
        // "missing output". The module guards this in its script but not its stub.
        ext.prefix = { "${meta.id}_backsub" }
        publishDir = [
            path: { "${params.outdir}/preprocessing/background_subtraction" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: COREOGRAPH {
        ext.args = params.coreograph_args
        // Load-bearing: cores are named {prefix}_core001 and sopa derives element names from filenames.
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/preprocessing/dearray" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Metrics JSON published beside the HTML so unattended runs can gate on it.
    withName: QC_METRICS {
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: QC_IMAGES {
        // Tuning goes here, not in params: --resolutions, --resolution, --arcsinh-cofactor, --max-cells, --n-windows.
        // Do not set --nuclear-pattern here; it would override the marker sheet's channel_role == 'dna'.
        ext.args = ""
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Only the manifest: PUBLISH_SPATIALDATA publishes the merged store after this step.
    withName: MERGE_SPATIALDATA {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('_merge_manifest.json') ? filename : null },
        ]
    }

    // Slide summary page, published beside the per-core pages.
    withName: MERGE_REPORT {
        ext.args = ""
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: QC_REPORT {
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
