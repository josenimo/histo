/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: BASICPY {
        // One task per cycle, so both the tag and the output prefix need the
        // cycle number; without it every cycle of a sample writes the same names.
        tag = { "${meta.id}_cycle${meta.cycle_number}" }
        ext.prefix = { "${meta.id}_cycle${meta.cycle_number}" }
        publishDir = [
            path: { "${params.outdir}/preprocessing/illumination" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: ASHLAR {
        ext.args = params.ashlar_args
        publishDir = [
            path: { "${params.outdir}/preprocessing/registration" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: BACKSUB {
        ext.args = params.backsub_args
        // Required, not cosmetic. backsub's input is Ashlar's output, and without
        // a distinct prefix the output would take the same name. Nextflow excludes
        // input files from output matching, so the task fails with "missing output"
        // rather than anything informative. The module guards this in its script
        // block but not in its stub.
        ext.prefix = { "${meta.id}_backsub" }
        publishDir = [
            path: { "${params.outdir}/preprocessing/background_subtraction" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: COREOGRAPH {
        ext.args = params.coreograph_args
        // The patched module uses this to name cores {prefix}_core001, which is
        // what gives each core an identity linked to its slide. sopa derives
        // SpatialData element names from filenames, so this is load-bearing.
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/preprocessing/dearray" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // QC. The metrics JSON is published beside the HTML on purpose: the report is for a
    // person, and a pass-or-fail gate for unattended runs will read the JSON.
    withName: QC_METRICS {
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: QC_IMAGES {
        // Tuning lives here rather than in a pipeline parameter, so that changing a
        // Leiden ladder or a crop count does not widen the public interface. The
        // defaults are the script's own; this block documents where to reach them.
        //
        //   --resolutions 0.1,0.2,0.3,0.5,0.8,1.2,1.6,2.0   swept and drawn as a tree
        //   --resolution 0.5              pin one instead of choosing by stability
        //   --stability-floor 0.9         agreement required to call a resolution stable
        //   --arcsinh-cofactor 150        one cofactor instead of one per channel
        //   --max-cells 0                 cluster every cell rather than 50,000
        //   --n-windows 6 --window 1000   how many crops, and how large
        //   --cells-per-cluster 5         snapshots per cluster
        //   --nuclear-pattern DAPI        which channels are the nuclear stain
        ext.args = ""
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: QC_REPORT {
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
