/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Real-data test against the small mIF fixture
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    The fixture is a 2x2 tile crop of exemplar001: two cycles, two channels each,
    1280x1080 tiles, uint16, 0.65 um/px. It stitches to 2112 x 2510 and gives nine
    patches at patch_width_pixel = 1000, so tiled segmentation and boundary
    resolution are actually exercised rather than run once.

    It is ~43 MB and lives outside this repository, because git keeps every version
    of a binary forever. Point HISTO_FIXTURE at it:

        export HISTO_FIXTURE=/fast/AG_Coscia/Jose/HISTO/test3_fixture
        bash tools/make_fixture_sheets.sh
        nextflow run . -profile singularity,size_tiny,slurm,test_fixture --outdir results

    The two CSVs this profile reads are written by that script rather than committed,
    because a samplesheet's paths resolve against the launch directory and so must be
    absolute. See tests/README.md.

    This needs all seven containers, so it does not run in GitHub CI. It is a
    before-release check, run by hand on the cluster.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name = 'Fixture test'
    config_profile_description = 'Small real mIF dataset, whole pipeline, asserted against a recorded baseline'

    // Absolute paths, because a samplesheet's contents are resolved against the
    // launch directory and this is run from wherever is convenient.
    //
    // The `?:` fallback is doing real work. An unset variable would otherwise
    // interpolate to the literal "null", and the run would fail with a path starting
    // "null/" or, worse, with "Missing required parameter(s): input" -- neither of
    // which mentions the variable. With the fallback, nf-schema's exists check
    // reports the path it tried, and the path says what is wrong:
    //
    //   the file 'HISTO_FIXTURE_IS_NOT_SET/samplesheet_fixture.csv' does not exist
    //
    // This is written as a repeated expression rather than a local variable because
    // Nextflow's config parser rejects `def` at the top level of a config file:
    // "Variable declarations cannot be mixed with config statements". Config files
    // take config statements only, not arbitrary Groovy.
    input = "${System.getenv('HISTO_FIXTURE') ?: 'HISTO_FIXTURE_IS_NOT_SET'}/samplesheet_fixture.csv"

    // The marker sheet is no longer set here. It is a marker_sheet column in
    // samplesheet_fixture.csv, which tools/make_fixture_sheets.sh writes into
    // $HISTO_FIXTURE along with the marker sheet it points at.

    use_preprocessing = true
    technology = "ome_tif"

    // 2510 / 1000 -> 3 across, 2112 / 1000 -> 3 down. Nine patches. Lower this and
    // the run gets slower without testing anything more; raise it past ~2600 and
    // the whole image becomes one patch and boundary resolution goes untested.
    patch_width_pixel = 1000
    patch_overlap_pixel = 50

    use_cellpose = true
    cellpose_channels = "DNA_6"
    cellpose_diameter = 35

    aggregate_channels = true
}
