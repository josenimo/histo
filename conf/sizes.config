/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Resource profiles by input image size
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Pick one per run, alongside an executor profile:

        -profile size_medium,singularity

    Rough guide, on the *stitched* image rather than the raw tiles:

        size_tiny     under ~1 GB, for test datasets
        size_small    up to ~10 GB
        size_medium   ~10 to ~40 GB
        size_huge     ~40 GB and above

    size_tiny is the only tier derived from measurement. The other three are estimates
    and should be rewritten from trace data as real runs of each size happen.

    ----------------------------------------------------------------------------------
    WHAT SCALES AND WHAT DOES NOT

    Only two kinds of process scale with input size, and they scale for different
    reasons:

      Whole-image steps. BASICPY, ASHLAR, BACKSUB, COREOGRAPH and TO_SPATIALDATA all
      hold or stream a substantial fraction of the image. Their memory tracks pixel
      count directly. ASHLAR is the worst of them: it holds the output mosaic while
      registering cycles onto it.

      Cell-count steps. RESOLVE_*, AGGREGATE, FLUO_ANNOTATION and MERGE_SPATIALDATA
      scale with how many cells were found, which correlates with tissue area rather
      than file size. A large mostly-empty slide is cheap here.

      PUBLISH_SPATIALDATA appears in no tier on purpose. It runs no command, and the
      cost of publishing the store is Nextflow's copy, which happens outside the task.

    Tiled segmentation deliberately does NOT scale. PATCH_SEGMENTATION_* runs on one
    patch at a time, so its cost is set by patch_width_pixel, not by slide size. That
    size independence is the reason sopa was chosen for the downstream half, and
    scaling it here would throw that away: a bigger slide should mean more segmentation
    tasks, not bigger ones. If those tasks need more memory, change patch_width_pixel.

    ----------------------------------------------------------------------------------
    THE NUMBERS ARE ESTIMATES

    Nothing here has been measured. They are starting points chosen to fail loudly on
    the side of over-requesting rather than to be efficient, because a job killed at
    hour six for want of 8 GB costs far more than an over-sized allocation that queued
    a little longer.

    Replace them with real figures from `seff <jobid>` or the execution trace. The
    Nextflow trace file, already enabled in nextflow.config, records peak_rss and
    realtime per task, which is exactly what these should be derived from.

    `* task.attempt` on memory means a retry after an OOM kill doubles the request.
    base.config retries on the exit codes SLURM uses for OOM and timeout.
----------------------------------------------------------------------------------------
*/

profiles {

    size_tiny {
        params.config_profile_description = 'Resources for test-sized images under ~1 GB'

        // The only tier with measured numbers behind it. Everything below is derived
        // from a real exemplar001 run (318 MB, 3 cycles, 12 channels, 3138 x 2511
        // stitched) on max-login, 2026-08-06. Measured peak_rss in the comments;
        // requests are roughly four times that, and walltimes roughly ten times the
        // observed runtime.
        //
        // The headroom looks generous against these numbers and is meant to be. This
        // tier covers anything up to ~1 GB, not just this dataset, and a test run that
        // dies for want of memory wastes more time than an idle allocation does.
        //
        // Do not read these as a guide to the larger tiers. Nothing here scales
        // linearly: the whole image fits in cache at this size, which is exactly what
        // stops being true at 10 GB.
        process {
            withName: 'BASICPY'        { cpus = 2; memory = { 4.GB * task.attempt }; time = { 30.m * task.attempt } }  // 1.1 GB, 20 s
            withName: 'ASHLAR'         { cpus = 2; memory = { 8.GB * task.attempt }; time = { 1.h  * task.attempt } }  // 634 MB, 29 s
            withName: 'BACKSUB'        { cpus = 2; memory = { 4.GB * task.attempt }; time = { 30.m * task.attempt } }  // not exercised
            withName: 'COREOGRAPH'     { cpus = 2; memory = { 8.GB * task.attempt }; time = { 1.h  * task.attempt } }  // not exercised
            withName: 'TO_SPATIALDATA' { cpus = 2; memory = { 8.GB * task.attempt }; time = { 1.h  * task.attempt } }  // 785 MB, 28 s

            withName: 'RESOLVE_CELLPOSE'  { cpus = 2; memory = { 4.GB * task.attempt }; time = { 30.m * task.attempt } }  // 515 MB, 34 s
            withName: 'RESOLVE_STARDIST'  { cpus = 2; memory = { 4.GB * task.attempt }; time = { 30.m * task.attempt } }  // not exercised
            withName: 'AGGREGATE'         { cpus = 2; memory = { 4.GB * task.attempt }; time = { 30.m * task.attempt } }  // 858 MB, 18 s
            withName: 'QC_METRICS'  { cpus = 2; memory = { 4.GB * task.attempt }; time = { 30.m * task.attempt } }  // streams row bands
            withName: 'QC_IMAGES'   { cpus = 2; memory = { 8.GB * task.attempt }; time = { 1.h * task.attempt } }  // graph over cells
            withName: 'QC_REPORT'   { cpus = 1; memory = { 2.GB * task.attempt }; time = { 15.m * task.attempt } }  // JSON to HTML
            withName: 'MERGE_SPATIALDATA' { cpus = 2; memory = { 8.GB * task.attempt }; time = { 1.h  * task.attempt } }  // not exercised

            // FLUO_ANNOTATION is set here but not in the three larger tiers, which is
            // an inconsistency rather than a decision: the header above lists it as a
            // cell-count step and it was left out. Without an override it inherits
            // process_medium from base.config. The cost of that omission was measured
            // on REPORT, which had the same gap: a one-minute task asked for 36 GB.
            withName: 'FLUO_ANNOTATION' { cpus = 2; memory = { 4.GB * task.attempt }; time = { 30.m * task.attempt } }  // not exercised
        }
    }

    size_small {
        params.config_profile_description = 'Resources for stitched images up to ~50 GB'

        process {
            // Whole-image steps
            withName: 'BASICPY'        { cpus = 4; memory = { 48.GB * task.attempt }; time = { 3.h  * task.attempt } }
            withName: 'ASHLAR'         { cpus = 4; memory = { 100.GB * task.attempt }; time = { 8.h  * task.attempt } }
            withName: 'BACKSUB'        { cpus = 2; memory = { 48.GB * task.attempt }; time = { 4.h  * task.attempt } }
            withName: 'COREOGRAPH'     { cpus = 4; memory = { 48.GB * task.attempt }; time = { 4.h  * task.attempt } }
            withName: 'TO_SPATIALDATA' { cpus = 4; memory = { 32.GB * task.attempt }; time = { 4.h  * task.attempt } }

            // Cell-count steps
            withName: 'RESOLVE_CELLPOSE'  { cpus = 2; memory = { 16.GB * task.attempt }; time = { 2.h * task.attempt } }
            withName: 'RESOLVE_STARDIST'  { cpus = 2; memory = { 16.GB * task.attempt }; time = { 2.h * task.attempt } }
            withName: 'AGGREGATE'         { cpus = 4; memory = { 16.GB * task.attempt }; time = { 2.h * task.attempt } }
            withName: 'QC_METRICS'  { cpus = 2; memory = { 8.GB * task.attempt }; time = { 1.h * task.attempt } }  // streams row bands
            withName: 'QC_IMAGES'   { cpus = 4; memory = { 16.GB * task.attempt }; time = { 2.h * task.attempt } }  // graph over cells
            withName: 'QC_REPORT'   { cpus = 1; memory = { 2.GB * task.attempt }; time = { 30.m * task.attempt } }  // JSON to HTML
            withName: 'MERGE_SPATIALDATA' { cpus = 2; memory = { 16.GB * task.attempt }; time = { 2.h * task.attempt } }
        }
    }

    size_medium {
        params.config_profile_description = 'Resources for stitched images of ~50 to ~200 GB'

        process {
            withName: 'BASICPY'        { cpus = 4;  memory = { 96.GB * task.attempt }; time = { 5.h  * task.attempt } }
            withName: 'ASHLAR'         { cpus = 8;  memory = { 150.GB * task.attempt }; time = { 24.h * task.attempt } }
            withName: 'BACKSUB'        { cpus = 4;  memory = { 96.GB * task.attempt }; time = { 12.h  * task.attempt } }
            withName: 'COREOGRAPH'     { cpus = 8;  memory = { 96.GB * task.attempt }; time = { 12.h  * task.attempt } }
            withName: 'TO_SPATIALDATA' { cpus = 8;  memory = { 96.GB * task.attempt }; time = { 8.h  * task.attempt } }

            withName: 'RESOLVE_CELLPOSE'  { cpus = 4; memory = { 32.GB * task.attempt }; time = { 4.h * task.attempt } }
            withName: 'RESOLVE_STARDIST'  { cpus = 4; memory = { 32.GB * task.attempt }; time = { 4.h * task.attempt } }
            withName: 'AGGREGATE'         { cpus = 8; memory = { 32.GB * task.attempt }; time = { 4.h * task.attempt } }
            withName: 'QC_METRICS'  { cpus = 2; memory = { 16.GB * task.attempt }; time = { 2.h * task.attempt } }  // streams row bands
            withName: 'QC_IMAGES'   { cpus = 4; memory = { 32.GB * task.attempt }; time = { 4.h * task.attempt } }  // graph over cells
            withName: 'QC_REPORT'   { cpus = 1; memory = { 4.GB * task.attempt }; time = { 30.m * task.attempt } }  // JSON to HTML
            withName: 'MERGE_SPATIALDATA' { cpus = 4; memory = { 32.GB * task.attempt }; time = { 6.h * task.attempt } }
        }
    }

    size_huge {
        params.config_profile_description = 'Resources for stitched images of ~200 GB and above'

        process {
            // A second retry is allowed here. At this scale a wrong guess is expensive
            // to rediscover, and the doubling on task.attempt gives the retry a real
            // chance of succeeding rather than just repeating the failure.
            maxRetries = 2

            withName: 'BASICPY'        { cpus = 8;  memory = { 64.GB  * task.attempt }; time = { 12.h  * task.attempt } }
            withName: 'ASHLAR'         { cpus = 16; memory = { 150.GB * task.attempt }; time = { 72.h * task.attempt } }
            withName: 'BACKSUB'        { cpus = 8;  memory = { 128.GB * task.attempt }; time = { 24.h * task.attempt } }
            withName: 'COREOGRAPH'     { cpus = 16; memory = { 150.GB * task.attempt }; time = { 24.h * task.attempt } }
            withName: 'TO_SPATIALDATA' { cpus = 16; memory = { 150.GB * task.attempt }; time = { 24.h * task.attempt } }

            withName: 'RESOLVE_CELLPOSE'  { cpus = 8;  memory = { 64.GB * task.attempt }; time = { 8.h  * task.attempt } }
            withName: 'RESOLVE_STARDIST'  { cpus = 8;  memory = { 64.GB * task.attempt }; time = { 8.h  * task.attempt } }
            withName: 'AGGREGATE'         { cpus = 16; memory = { 64.GB * task.attempt }; time = { 8.h  * task.attempt } }
            withName: 'QC_METRICS'  { cpus = 4; memory = { 32.GB * task.attempt }; time = { 4.h * task.attempt } }  // streams row bands
            withName: 'QC_IMAGES'   { cpus = 8; memory = { 64.GB * task.attempt }; time = { 8.h * task.attempt } }  // graph over cells
            withName: 'QC_REPORT'   { cpus = 1; memory = { 4.GB * task.attempt }; time = { 1.h * task.attempt } }  // JSON to HTML
            withName: 'MERGE_SPATIALDATA' { cpus = 8;  memory = { 64.GB * task.attempt }; time = { 12.h * task.attempt } }
        }
    }
}
