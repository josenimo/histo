/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Pre-release check 1 of 2: the WSI path on exemplar-001
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Three cycles of mIF, twelve channels, no background subtraction and no dearray:
    the plain slide path from raw tiles to a published store. Its counterpart,
    test_exemplar002, covers dearray and subtraction.

    Cluster only. Needs the containers, so it does not run in CI -- and that is a
    decision rather than a gap. The images come to about 8.8 GB on disk for this
    path against roughly 14 GB free on a GitHub runner and a 10 GB cache quota,
    re-pulled every run. Real pixels are checked by hand before a release instead.

        export HISTO_EXEMPLARS=/fast/AG_Coscia/$USER/HISTO/exemplars
        bash tools/fetch_exemplars.sh
        nf-test test tests/exemplar001.nf.test \
            --profile test_exemplar001,singularity,size_small,slurm

    Without HISTO_EXEMPLARS the profile fails immediately and the path it prints
    says why, rather than failing later with something that does not mention it.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name = 'Exemplar-001, WSI'
    config_profile_description = 'Three mIF cycles, whole slide, no subtraction or dearray'

    input = "${System.getenv('HISTO_EXEMPLARS') ?: 'HISTO_EXEMPLARS_IS_NOT_SET'}/samplesheet_exemplar001.csv"

    use_preprocessing = true
    technology = "ome_tif"

    // Neither, deliberately. This profile is the plain path; test_exemplar002 is
    // where dearray and subtraction are exercised, on a slide that really has
    // autofluorescence channels rather than a marker relabelled to look like one.
    use_backsub = false
    use_tma_dearray = false

    // exemplar-001 stitches to roughly 3500 x 2600. At 1500 that is 3 x 2, so
    // segmentation genuinely tiles and boundary resolution is exercised. One patch
    // would mean it was not, which is how an early run silently behaved.
    patch_width_pixel = 1500
    patch_overlap_pixel = 50

    use_cellpose = true
    cellpose_channels = "DNA_6"
    cellpose_diameter = 35

    aggregate_channels = true
}
