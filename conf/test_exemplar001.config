/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Pre-release check 1 of 2: the WSI path on exemplar-001
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Plain WSI path: three cycles, no subtraction or dearray. Cluster only, by
    decision: the containers (~8.8 GB) do not fit a GitHub runner.

        export HISTO_EXEMPLARS=/fast/AG_Coscia/$USER/HISTO/exemplars
        bash tools/fetch_exemplars.sh
        nf-test test tests/exemplar001.nf.test \
            --profile test_exemplar001,singularity,size_small,slurm

    Fails immediately if HISTO_EXEMPLARS is unset.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name = 'Exemplar-001, WSI'
    config_profile_description = 'Three mIF cycles, whole slide, no subtraction or dearray'

    input = "${System.getenv('HISTO_EXEMPLARS') ?: 'HISTO_EXEMPLARS_IS_NOT_SET'}/samplesheet_exemplar001.csv"

    use_preprocessing = true
    technology = "ome_tif"

    // Off on purpose; test_exemplar002 covers both on real autofluorescence data.
    use_backsub = false
    use_tma_dearray = false

    // Stitches to ~3500 x 2600, so 1500 gives 3 x 2 patches and exercises boundary resolution.
    patch_width_pixel = 1500
    patch_overlap_pixel = 50

    use_cellpose = true
    cellpose_channels = "DNA_6"
    cellpose_diameter = 35

    aggregate_channels = true
}
