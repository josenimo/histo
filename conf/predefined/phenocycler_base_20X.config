params {
  // Reader. ome_tif because this pipeline's input is always a stitched OME-TIFF
  // from Ashlar; the value of this profile is the tuned parameters below.
  technology = 'ome_tif'

  // Patches
  patch_width_pixel = 3000
  patch_overlap_pixel = 40

  // Cellpose
  use_cellpose = true
  cellpose_diameter = 12
  cellpose_channels = 'DAPI'
  flow_threshold = 2
  cellprob_threshold = -6

  // Filtering
  min_area_pixels2 = 38
  min_intensity_ratio = 0.1

  // Aggregation
  aggregate_channels = true
  expand_radius_ratio = 0.1

  // Physical pixel size at this magnification is 0.5 µm. Recorded as a comment
  // rather than a parameter: EXPLORER has been removed, and it consumed the
  // only param that carried physical scale. Where scale should live is still
  // open, see ROADMAP.md. Keep this number; it is instrument knowledge.
}
