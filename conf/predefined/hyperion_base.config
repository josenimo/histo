params {
  // Reader. ome_tif because this pipeline's input is always a stitched OME-TIFF
  // from Ashlar; the value of this profile is the tuned parameters below.
  technology = 'ome_tif'

  // Patches
  patch_width_pixel = 3000
  patch_overlap_pixel = 40

  // Cellpose
  use_cellpose = true
  cellpose_diameter = 8
  cellpose_channels = 'DNA1'
  flow_threshold = 2
  cellprob_threshold = -6

  // Filtering
  min_area_pixels2 = 16
  min_intensity_ratio = 0.1

  // Aggregation
  aggregate_channels = true
  expand_radius_ratio = 0.1

  // Explorer
  pixel_size = 1
}
