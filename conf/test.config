/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run josenimo/histo -profile test,singularity --outdir <OUTDIR>

    Was a Proseg profile inherited from nf-core/sopa. Rebuilt around Cellpose, since
    transcript-based segmentation is out of scope. Still uses sopa's synthetic toy_dataset;
    Phase 6 replaces it with a real cropped mIF tile.
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h',
    ]
}

params {
    config_profile_name = 'Test profile with Cellpose'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input = "${baseDir}/tests/samplesheet.csv"

    // Preprocessing: skipped. toy_dataset generates synthetic SpatialData
    // in-process, so there are no raw tiles to correct or stitch.
    use_preprocessing = false

    // Reader
    technology = "toy_dataset"

    // Patches
    patch_width_pixel = 5000
    patch_overlap_pixel = 50

    // Cellpose segmentation
    use_cellpose = true
    cellpose_diameter = 35
    cellpose_channels = 'DAPI'
    flow_threshold = 2
    cellprob_threshold = -6

    // Filtering
    min_area_pixels2 = 2500

    // Aggregation
    aggregate_channels = true

    // Annotation. Enabled so the retained fluorescence annotation path is
    // actually exercised; a feature kept but never run rots silently.
    use_fluorescence_annotation = true
    marker_cell_dict = '{"CK": "Tumoral cell", "CD3": "T cell", "CD20": "B cell"}'
}
