// Parameters the schema does not declare must stop the run.
//
// nf-schema is supposed to do this through `validation.failUnrecognisedParams`, but that
// option aborts the run with a MissingPropertyException in every released version, so the
// check is ours. These tests are what says it works.
//
// The typo in the second case is not invented: pipeline_info/params_*.json from the
// published WSI run records both `use_use_tma_dearray` and `use_tma_dearray`.

nextflow_function {

    name "rejectUnknownParams"
    script "../subworkflows/local/utils_nfcore_histo_pipeline/main.nf"
    function "rejectUnknownParams"
    tag "unit"
    tag "validation"

    test("parameters the schema declares are accepted") {
        when {
            function {
                """
                input[0] = [
                    input: 'samplesheet.csv',
                    outdir: 'results',
                    use_cellpose: true,
                    patch_width_pixel: 1000
                ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("a doubled prefix is rejected and the message names the parameter meant") {
        when {
            function {
                """
                input[0] = [
                    outdir: 'results',
                    use_use_tma_dearray: true
                ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains('use_use_tma_dearray') }
            assert function.stdout.any { it.contains('did you mean: use_tma_dearray') }
        }
    }

    test("a parameter with no near match is still rejected, without a bogus suggestion") {
        when {
            function {
                """
                input[0] = [
                    outdir: 'results',
                    completely_made_up: 42
                ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains('completely_made_up') }
            assert !function.stdout.any { it.contains('did you mean') }
        }
    }

    test("nf_test_output is injected by the test runner, not the user, so it is ignored") {
        when {
            function {
                """
                input[0] = [
                    outdir: 'results',
                    nf_test_output: 'somewhere'
                ]
                """
            }
        }
        then {
            assert function.success
        }
    }
}
