// Ashlar and Coreograph take their nuclear channel by index from *_args, not from the marker
// sheet. A non-dna channel there warns but does not fail. Warnings are read from nextflow.log.

nextflow_function {

    name "warnReferenceChannels"
    script "../subworkflows/local/utils_nfcore_histo_pipeline/main.nf"
    function "warnReferenceChannels"
    tag "unit"
    tag "validation"

    test("dna first in every cycle, default args: no warning") {
        when {
            params {
                ashlar_args = '--maximum-shift 30'
                coreograph_args = '--downsampleFactor 5 --channel 0 --buffer 2'
                use_tma_dearray = true
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'DAPI',   channel_role: 'dna' ],
                    [ channel_number: 2, cycle_number: 1, marker_name: 'CD3',    channel_role: 'marker' ],
                    [ channel_number: 3, cycle_number: 2, marker_name: 'DAPI_2', channel_role: 'dna' ],
                    [ channel_number: 4, cycle_number: 2, marker_name: 'CD8',    channel_role: 'marker' ]
                ]
                """
            }
        }
        then {
            assert function.success
            assert !file("${metaDir}/nextflow.log").text.contains("not a dna channel")
        }
    }

    test("dna in a different slot in one cycle warns and names that cycle") {
        when {
            params {
                ashlar_args = '--maximum-shift 30'
                use_tma_dearray = false
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'DAPI',   channel_role: 'dna' ],
                    [ channel_number: 2, cycle_number: 1, marker_name: 'CD3',    channel_role: 'marker' ],
                    [ channel_number: 3, cycle_number: 2, marker_name: 'CD8',    channel_role: 'marker' ],
                    [ channel_number: 4, cycle_number: 2, marker_name: 'DAPI_2', channel_role: 'dna' ]
                ]
                """
            }
        }
        then {
            assert function.success
            def warning = file("${metaDir}/nextflow.log").readLines().find { it.contains("Ashlar") && it.contains("not a dna channel") }
            assert warning?.contains("cycle 2: CD8")
            assert !warning.contains("cycle 1")
        }
    }

    test("ashlar --align-channel=N is read") {
        when {
            params {
                ashlar_args = '--maximum-shift 30 --align-channel=1'
                use_tma_dearray = false
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'CD3',    channel_role: 'marker' ],
                    [ channel_number: 2, cycle_number: 1, marker_name: 'DAPI',   channel_role: 'dna' ],
                    [ channel_number: 3, cycle_number: 2, marker_name: 'CD8',    channel_role: 'marker' ],
                    [ channel_number: 4, cycle_number: 2, marker_name: 'DAPI_2', channel_role: 'dna' ]
                ]
                """
            }
        }
        then {
            assert function.success
            assert !file("${metaDir}/nextflow.log").text.contains("not a dna channel")
        }
    }

    test("coreograph --channel on a marker warns on a TMA") {
        when {
            params {
                ashlar_args = '-c 0'
                coreograph_args = '--downsampleFactor 5 --channel 1 --buffer 2'
                use_tma_dearray = true
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'DAPI', channel_role: 'dna' ],
                    [ channel_number: 2, cycle_number: 1, marker_name: 'CD3',  channel_role: 'marker' ]
                ]
                """
            }
        }
        then {
            assert function.success
            def warning = file("${metaDir}/nextflow.log").readLines().find { it.contains("Coreograph") && it.contains("not a dna channel") }
            assert warning?.contains("CD3")
        }
    }

    test("coreograph args are ignored without dearraying") {
        when {
            params {
                ashlar_args = ''
                coreograph_args = '--channel 1'
                use_tma_dearray = false
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'DAPI', channel_role: 'dna' ],
                    [ channel_number: 2, cycle_number: 1, marker_name: 'CD3',  channel_role: 'marker' ]
                ]
                """
            }
        }
        then {
            assert function.success
            assert !file("${metaDir}/nextflow.log").text.contains("not a dna channel")
        }
    }

    test("dna last in every cycle with -c -1 and --channel -1: no warning, even with uneven cycles") {
        when {
            params {
                ashlar_args = '-c -1'
                coreograph_args = '--downsampleFactor 5 --channel -1 --buffer 2'
                use_tma_dearray = true
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'CD3',    channel_role: 'marker' ],
                    [ channel_number: 2, cycle_number: 1, marker_name: 'CD4',    channel_role: 'marker' ],
                    [ channel_number: 3, cycle_number: 1, marker_name: 'DAPI',   channel_role: 'dna' ],
                    [ channel_number: 4, cycle_number: 2, marker_name: 'CD8',    channel_role: 'marker' ],
                    [ channel_number: 5, cycle_number: 2, marker_name: 'DAPI_2', channel_role: 'dna' ]
                ]
                """
            }
        }
        then {
            assert function.success
            assert !file("${metaDir}/nextflow.log").text.contains("not a dna channel")
        }
    }

    test("-c -1 warns for a cycle whose last channel is not dna") {
        when {
            params {
                ashlar_args = '-c -1'
                use_tma_dearray = false
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'CD3',    channel_role: 'marker' ],
                    [ channel_number: 2, cycle_number: 1, marker_name: 'DAPI',   channel_role: 'dna' ],
                    [ channel_number: 3, cycle_number: 2, marker_name: 'DAPI_2', channel_role: 'dna' ],
                    [ channel_number: 4, cycle_number: 2, marker_name: 'CD8',    channel_role: 'marker' ]
                ]
                """
            }
        }
        then {
            assert function.success
            def warning = file("${metaDir}/nextflow.log").readLines().find { it.contains("Ashlar") && it.contains("not a dna channel") }
            assert warning?.contains("index -1")
            assert warning.contains("cycle 2: CD8")
        }
    }
}
