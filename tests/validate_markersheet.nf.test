// Marker sheet checks that JSON Schema cannot express. Each case must be seen to fail,
// and the message text is asserted too (docs/decisions.md).

nextflow_function {

    name "validateMarkersheet"
    script "../subworkflows/local/utils_nfcore_histo_pipeline/main.nf"
    function "validateMarkersheet"
    tag "unit"
    tag "validation"

    test("a sheet with a dna channel in every cycle is accepted") {
        when {
            params {
                use_backsub = false
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'DAPI',  channel_role: 'dna' ],
                    [ channel_number: 2, cycle_number: 1, marker_name: 'CD3',   channel_role: 'marker' ],
                    [ channel_number: 3, cycle_number: 2, marker_name: 'DAPI_2', channel_role: 'dna' ],
                    [ channel_number: 4, cycle_number: 2, marker_name: 'CD8',   channel_role: 'marker' ]
                ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("a cycle with no dna channel is rejected, and the message names the cycle") {
        when {
            params {
                use_backsub = false
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'DAPI', channel_role: 'dna' ],
                    [ channel_number: 2, cycle_number: 2, marker_name: 'CD8',  channel_role: 'marker' ]
                ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("channel_role 'dna'") }
            assert function.stdout.any { it.contains("[2]") }
        }
    }

    test("a background pointing at something other than an autofluorescence channel is rejected") {
        when {
            params {
                use_backsub = false
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'DAPI', channel_role: 'dna' ],
                    [ channel_number: 2, cycle_number: 1, marker_name: 'CD3',  channel_role: 'marker', background: 'DAPI' ]
                ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("'autofluorescence'") }
            assert function.stdout.any { it.contains("CD3 -> DAPI") }
        }
    }

    test("a background naming a channel that does not exist is rejected even with backsub off") {
        when {
            params {
                use_backsub = false
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'DAPI', channel_role: 'dna' ],
                    [ channel_number: 2, cycle_number: 1, marker_name: 'CD3',  channel_role: 'marker', background: 'AF_typo' ]
                ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("no such channel") }
        }
    }

    test("a background pointing at an autofluorescence channel is accepted") {
        when {
            params {
                use_backsub = false
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'DAPI', channel_role: 'dna' ],
                    [ channel_number: 2, cycle_number: 1, marker_name: 'AF',   channel_role: 'autofluorescence' ],
                    [ channel_number: 3, cycle_number: 1, marker_name: 'CD3',  channel_role: 'marker', background: 'AF' ]
                ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("a repeated marker_name is rejected before anything expensive runs") {
        // Caught here, before Ashlar: the role lookup keeps the last value for a repeated key,
        // so the background check would pass or fail for an invisible reason.
        when {
            params {
                use_backsub = false
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'DAPI', channel_role: 'dna' ],
                    [ channel_number: 2, cycle_number: 1, marker_name: 'AF',   channel_role: 'autofluorescence' ],
                    [ channel_number: 3, cycle_number: 1, marker_name: 'AF',   channel_role: 'marker' ]
                ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("marker_name must be unique") }
            assert function.stdout.any { it.contains("[AF]") }
        }
    }

    test("channel_number restarting each cycle is rejected") {
        when {
            params {
                use_backsub = false
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'DAPI',   channel_role: 'dna' ],
                    [ channel_number: 1, cycle_number: 2, marker_name: 'DAPI_2', channel_role: 'dna' ]
                ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("continuously across all cycles") }
        }
    }

    test("with backsub, removing the only dna channel is rejected") {
        when {
            params {
                use_backsub = true
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'DAPI', channel_role: 'dna',    exposure: 100, remove: true ],
                    [ channel_number: 2, cycle_number: 1, marker_name: 'CD3',  channel_role: 'marker', exposure: 100 ]
                ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("at least one 'dna' channel without remove") }
        }
    }

    test("with backsub, removing a later-cycle dna channel is accepted") {
        when {
            params {
                use_backsub = true
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'DAPI',   channel_role: 'dna', exposure: 100 ],
                    [ channel_number: 2, cycle_number: 2, marker_name: 'DAPI_2', channel_role: 'dna', exposure: 100, remove: true ]
                ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("with backsub, a segmentation channel that is removed is rejected") {
        when {
            params {
                use_backsub = true
                cellpose_channels = 'DAPI_2 DAPI'
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'DAPI',   channel_role: 'dna', exposure: 100 ],
                    [ channel_number: 2, cycle_number: 2, marker_name: 'DAPI_2', channel_role: 'dna', exposure: 100, remove: true ]
                ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains("cellpose_channels") }
            assert function.stdout.any { it.contains("[DAPI_2]") }
        }
    }

    test("without backsub, remove is accepted with a warning that it does nothing") {
        when {
            params {
                use_backsub = false
            }
            function {
                """
                input[0] = [
                    [ channel_number: 1, cycle_number: 1, marker_name: 'DAPI', channel_role: 'dna' ],
                    [ channel_number: 2, cycle_number: 1, marker_name: 'AF',   channel_role: 'autofluorescence', remove: true ]
                ]
                """
            }
        }
        then {
            assert function.success
            // log.warn reaches nextflow.log but not stdout under the Nextflow 26 console.
            def warning = file("${metaDir}/nextflow.log").readLines().find { it.contains("remove has no effect without use_backsub") }
            assert warning?.contains("[AF]")
        }
    }
}
