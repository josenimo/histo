// The pre-stitched entry point (use_preprocessing = false) end to end.
// Under -stub so it runs in CI without containers; it checks wiring, not numbers.

nextflow_pipeline {

    name "Default profile: the pre-stitched entry point"
    script "../main.nf"
    profile "test"
    options "-stub"
    tag "stub"
    tag "pipeline"

    test("a pre-stitched image skips preprocessing and still reaches QC") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def ran = workflow.trace.succeeded().collect { it.name }
            def names = { proc -> ran.findAll { it.contains(proc) } }

            assertAll(
                { assert workflow.success },

                // Pre-stitched input: nothing preprocesses.
                { assert names("BASICPY").isEmpty() },
                { assert names("ASHLAR").isEmpty() },
                { assert names("COREOGRAPH").isEmpty() },
                { assert names("BACKSUB").isEmpty() },

                // No marker sheet on this path, so no channel renaming.
                { assert names("SET_CHANNEL_NAMES").isEmpty() },

                // Two patches at 5000 px; one would mean tiling silently collapsed.
                { assert names("PATCH_SEGMENTATION_CELLPOSE").size() == 2 },
                { assert names("RESOLVE_CELLPOSE").size() == 1 },
                { assert names("AGGREGATE").size() == 1 },

                // Enabled in conf/test.config so this path is exercised.
                { assert names("FLUO_ANNOTATION").size() == 1 },

                // Not a TMA, so no slide-level steps.
                { assert names("MERGE_SPATIALDATA").isEmpty() },
                { assert names("MERGE_REPORT").isEmpty() },

                { assert names("PUBLISH_SPATIALDATA").size() == 1 },
                { assert names("QC_METRICS").size() == 1 },
                { assert names("QC_IMAGES").size() == 1 },
                { assert names("QC_REPORT").size() == 1 },

                // A missing entry means a module lost its version capture.
                { assert path("$outputDir/pipeline_info/histo_software_versions.yml").exists() },
                { assert path("$outputDir/pipeline_info/histo_software_versions.yml").text.contains('AGGREGATE') }
            )
        }
    }
}
