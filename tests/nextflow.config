/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/sopa/'
}

aws.client.anonymous = true

// GitHub-hosted runners for private repos have 2 CPUs and 7 GB.
process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h',
    ]
}
