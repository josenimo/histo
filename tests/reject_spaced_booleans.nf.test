// `--use_qc false` enabled QC on a real run, and not for the reason it appears to.
//
// Nextflow reads `--use_qc` as a bare flag, sets it to boolean true, and discards the
// `false` completely: it reaches neither params nor the positional args. So the value is
// gone before any pipeline code runs, and workflow.commandLine is the only place it
// survives. That is why this check reads a string, and why it is given the command line
// as an argument rather than reading the global, so it can be tested at all.

nextflow_function {

    name "rejectSpacedBooleans"
    script "../subworkflows/local/utils_nfcore_histo_pipeline/main.nf"
    function "rejectSpacedBooleans"
    tag "unit"
    tag "validation"

    test("a boolean written with a space is rejected") {
        when {
            function {
                """
                input[0] = "nextflow run . -profile test '--use_qc false'"
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains('written with a space') }
            assert function.stdout.any { it.contains('--use_qc false') }
        }
    }

    test("the spaced form is rejected even when it would have produced the right answer") {
        // `--use_qc true` happens to work, for exactly the reason `--use_qc false` does
        // not. A form that is correct for one value and silently inverts the other is
        // worse than one that never works.
        when {
            function {
                """
                input[0] = "nextflow run . --use_qc true"
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.any { it.contains('--use_qc true') }
        }
    }

    test("a bare flag is accepted, and so is the option that follows it") {
        when {
            function {
                """
                input[0] = "nextflow run . --use_cellpose --outdir results"
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("a non-boolean parameter with a value is left alone") {
        when {
            function {
                """
                input[0] = "nextflow run . --outdir results --patch_width_pixel 1000"
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("-stub does not trip it") {
        // -stub puts a bare `true` into the positional args, which is why this cannot be
        // implemented as a check on positional arguments: every stub run would fail.
        when {
            function {
                """
                input[0] = "nextflow run . -profile laptop -stub"
                """
            }
        }
        then {
            assert function.success
        }
    }
}
