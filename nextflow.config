/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    josenimo/histo Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null

    // Preprocessing options
    //
    // use_preprocessing selects the shape of --input:
    //   true  (default) one row per acquisition cycle; raw tiles are illumination
    //                   corrected and stitched before the downstream half.
    //   false           one row per sample pointing at data sopa can already read.
    //                   For pre-stitched images, dearrayed TMA cores re-entering
    //                   the pipeline, and toy_dataset.
    //
    // Whether BaSiCPy runs is inferred from the samplesheet, not set here: give
    // dfp and ffp to use your own profiles, omit them to compute per cycle. They
    // are all-or-nothing per sample and validateIlluminationColumns enforces it.
    // The marker sheet is a samplesheet column rather than a parameter, because it
    // describes a sample and two samples in one run may have different channel
    // layouts. See assets/schema_input_cycle.json.
    use_preprocessing          = true
    ashlar_args                = '--maximum-shift 30'

    // Background subtraction. Off by default. Requires a marker sheet with an
    // exposure for every channel, and a background column naming the channel to
    // subtract; validateMarkersheet enforces both.
    use_backsub                = false
    backsub_args               = ''

    // TMA dearray. Off by default. This is the only step that changes the
    // cardinality of the pipeline: one slide becomes N cores, each continuing
    // through the downstream half as an independent sample.
    use_tma_dearray            = false
    coreograph_args            = '--downsampleFactor 5 --channel 0 --buffer 2'

    // Reader options
    technology                 = "ome_tif"

    // Patchify options
    patch_width_pixel          = null
    patch_overlap_pixel        = null
    image_scale                = null

    // Image preprocessing options
    gaussian_sigma             = null
    clip_limit                 = null
    clahe_kernel_size          = null

    // Tissue segmentation options
    use_tissue_segmentation    = false
    level                      = null
    mode                       = null
    tissue_segmentation_kwargs = null

    // Cellpose segmentation options
    use_cellpose               = false
    cellpose_diameter          = null
    cellpose_channels          = null
    flow_threshold             = null
    cellprob_threshold         = null
    cellpose_model_type        = null
    pretrained_model           = null
    cellpose_use_gpu           = false
    cellpose_kwargs            = null

    // Stardist segmentation options
    use_stardist               = false
    stardist_model_type        = null
    prob_thresh                = null
    nms_thresh                 = null
    stardist_channels          = null
    stardist_kwargs            = null

    // QC report options
    //
    // Only two switches. Everything else the QC scripts accept -- the nuclear-stain
    // pattern, the Leiden resolution ladder, the arcsinh cofactor, the degenerate-cell
    // threshold -- is tuning rather than configuration, and goes through ext.args in
    // conf/modules.config so it does not become part of the pipeline's public interface
    // before anyone has needed to change it.
    use_qc                      = true
    // The clustering and the image crops, which cost minutes where the metrics cost
    // seconds. Separable because an unattended run wants the JSON and may not want to
    // pay for the pictures.
    use_qc_images               = true

    // Fluorescence annotation options
    use_fluorescence_annotation = false
    fluorescence_cell_type_key  = null
    marker_cell_dict            = null

    // Cell filtering options
    //
    // null means no filtering at all, which is not what this comment used to say.
    // sopa does derive min_area from the diameter as (diameter/2)^2, about 15% of a
    // normal cell area, but only in its Python API: _cellpose.py does
    // `if min_area is None: min_area = (diameter / 2) ** 2`. The CLI this pipeline
    // calls declares `min_area: int = typer.Option(0, ...)`, so the None that would
    // trigger that derivation never arrives. argsCLI() skips nulls, no --min-area is
    // passed, and typer supplies 0.
    //
    // That matches what the published WSI run shows: its smallest cell is 4.3 px^2
    // and 1% of cells are under 48.6 px^2, against the ~306 px^2 that (35/2)^2 would
    // have given. Nothing was being filtered.
    //
    // Left as null rather than given a default, because choosing a floor changes
    // segmentation results and is a scientific decision. A fixed number is also wrong
    // across magnifications: the mIF presets range from 16 at 10X to 400 for macsima.
    // Set it per profile, or per run, not globally.
    min_area_pixels2           = null
    min_transcripts            = null
    min_intensity_ratio        = null

    // Aggregation options
    aggregate_genes            = null
    aggregate_channels         = null
    expand_radius_ratio        = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    // Caps resource requests to something a laptop has. Stub tasks do no work but
    // still request their declared resources, and process_high asks for 72 GB,
    // which no laptop will grant. resourceLimits caps the request rather than
    // overriding each process, so the DAG is unchanged.
    //
    // Composable and intended to be combined, for example:
    //   nextflow run . -profile laptop -stub -params-file params.yml
    //
    // Not for real work. AGENT_CONTEXT.md section 6 rules out local execution of
    // the actual containers, which are amd64 only.
    laptop {
        process {
            resourceLimits = [
                cpus: 4,
                memory: '8.GB',
                time: '1.h',
            ]
            // ashlar and backsub declare their versions with eval(), which
            // Nextflow evaluates in the task environment even under -stub. Without
            // the binaries on PATH the task fails with "Unable to evaluate output".
            // tests/stub_bin holds shims that print a version and nothing else.
            beforeScript = "export PATH=${projectDir}/tests/stub_bin:\$PATH"
        }
    }
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    slurm         { includeConfig 'conf/slurm.config'         }

    test          { includeConfig 'conf/test.config'          }
    test_cellpose { includeConfig 'conf/test_cellpose.config' }
    test_cellpose_multi_patches { includeConfig 'conf/test_cellpose_multi_patches.config' }
    test_cellpose_CK_DAPI { includeConfig 'conf/test_cellpose_CK_DAPI.config' }
    test_full     { includeConfig 'conf/test_full.config'     }
    // The two pre-release checks, run by hand on the cluster. See ROADMAP.
    test_exemplar001 { includeConfig 'conf/test_exemplar001.config' }
    test_exemplar002 { includeConfig 'conf/test_exemplar002.config' }

    hyperion_base  { includeConfig 'conf/predefined/hyperion_base.config' }
    macsima_base  { includeConfig 'conf/predefined/macsima_base.config' }
    phenocycler_base_40X  { includeConfig 'conf/predefined/phenocycler_base_40X.config' }
    phenocycler_base_10X  { includeConfig 'conf/predefined/phenocycler_base_10X.config' }
    phenocycler_base_20X  { includeConfig 'conf/predefined/phenocycler_base_20X.config' }
}

// Resource profiles by input image size: size_small, size_medium, size_huge.
// One file rather than three, so the tiers can be read side by side and kept in
// step. Included here at the top level, not inside the block above, because it
// declares its own `profiles` scope which Nextflow merges with that one; nesting
// a `profiles` block inside `profiles` is not valid.
includeConfig 'conf/sizes.config'

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load josenimo/histo custom profiles from different institutions.
// TODO Phase 4/5: this is a launch-time network fetch of nf-core/configs, which
// AGENT_CONTEXT.md section 6 rules out. Decide whether to drop it or vendor a
// local institutional config instead. Currently guarded only by NXF_OFFLINE.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    NUMBA_CACHE_DIR  = "/tmp/numba_cache_dir"
    MPLCONFIGDIR     = "/tmp/mplconfigdir"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
    // Explicit fields rather than the default set. The defaults record what a task
    // used but not what it asked for, and tuning conf/sizes.config is entirely a
    // question of the ratio between the two: `cpus`/`memory`/`time` are the request,
    // `%cpu`/`peak_rss`/`realtime` are the reality.
    fields  = 'task_id,hash,name,status,exit,attempt,cpus,memory,time,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'josenimo/histo'
    contributors    = [
        [
            name: 'Jose Nimo',
            affiliation: 'Max Delbrück Center for Molecular Medicine',
            email: 'jose.nimo@mdc-berlin.de',
            github: 'https://github.com/josenimo',
            contribution: ['author', 'maintainer'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: '' // TODO add ORCID
        ],
    ]
    homePage        = 'https://github.com/josenimo/histo'
    description     = """Processing, segmentation and quantification of multiplex immunofluorescence (mIF) images"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0'
}

// Nextflow plugins
plugins {
    // 2.7.2 is what subworkflows/nf-core/utils_nfschema_plugin was written against
    // and declares in its own tests. On 2.5.1 the cast_cli_params option that
    // subworkflow passes is silently ignored, so any numeric or boolean parameter
    // set on the command line fails validation as a string.
    id 'nf-schema@2.7.2' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
