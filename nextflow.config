/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Unified MCMICRO-SOPA Nextflow Config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // Inputs & Outputs
    use_mcmicro                = false                  // Master flag: Set to true for raw tile MCMICRO optical preprocessing
    input_image                = null                   // Single pre-stitched OME-TIFF image (Default SOPA Mode)
    input_cycle                = 'samplesheet_mif.csv'  // Multi-cycle raw tile samplesheet (MCMICRO Mode)
    marker_sheet               = 'markers_mif.csv'      // Marker sheet
    outdir                     = './results'            // Output directory
    sample_id                  = null                   // Optional sample identifier override

    // MCMICRO Module Options (Active when use_mcmicro = true)
    use_basicpy                = true                   // Default MCMICRO BaSiC Illumination Correction
    use_backsub                = false                  // Opt-in Background Subtraction
    use_tma_dearray            = false                  // Opt-in UNetCoreograph TMA Dearraying
    ashlar_args                = '--maximum-shift 30'
    backsub_args               = ''
    coreograph_args            = '--channel 0 --downsampleFactor 3 --buffer 2'

    // SOPA Spatial Parameters
    technology                 = 'ome_tif'
    use_cellpose               = true
    cellpose_channels          = '0'
    cellpose_diameter          = 35
    patch_width_pixel          = 1000
    patch_overlap_pixel        = 50
    aggregate_channels         = true

    // System Resource Limits
    max_memory                 = '32.GB'
    max_cpus                   = 8
}

// Global Process Configuration & Dynamic Retry Logic for 10GB-250GB Images
process {
    errorStrategy = { task.exitStatus in [137, 140, 7, 125] ? 'retry' : 'finish' }
    maxRetries    = 3

    withName: 'TO_SPATIALDATA|MAKE_IMAGE_PATCHES|RESOLVE_CELLPOSE|AGGREGATE|EXPLORER|REPORT' {
        container = '/fast/AG_Coscia/software/singularity/python_sopa.sif'
    }

    withName: 'ASHLAR' {
        container = 'labsyspharm/ashlar:1.17.0'
        memory    = { task.attempt > 1 ? 16.GB * task.attempt : 8.GB }
        cpus      = { task.attempt > 1 ? 8 : 4 }
    }
    withName: 'TO_SPATIALDATA' {
        memory    = { task.attempt > 1 ? 16.GB * task.attempt : 8.GB }
        cpus      = 4
    }
    withName: 'MAKE_IMAGE_PATCHES' {
        memory    = 4.GB
        cpus      = 2
    }
    withName: 'PATCH_SEGMENTATION_CELLPOSE' {
        container = 'community.wave.seqera.io/library/python_sopa_cellpose:64ef6bc9b8f69b5e'
        memory    = 8.GB
        cpus      = 4
    }
    withName: 'RESOLVE_CELLPOSE' {
        memory    = 8.GB
        cpus      = 4
    }
    withName: 'AGGREGATE' {
        memory    = 8.GB
        cpus      = 4
    }
    withName: 'EXPLORER' {
        memory    = 8.GB
        cpus      = 4
    }
    withName: 'REPORT' {
        memory    = 4.GB
        cpus      = 2
    }
}

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        envWhitelist = 'PATH,LD_LIBRARY_PATH'
    }
    slurm {
        process.executor       = 'slurm'
        singularity.enabled    = true
        singularity.autoMounts = true
        
        // HPC GPU configuration for Cellpose segmentation
        process {
            withName: 'PATCH_SEGMENTATION_CELLPOSE' {
                containerOptions = '--nv' // Enable NVIDIA GPU acceleration in Singularity
                cpus             = 4
                memory           = '32 GB'
            }
            withName: 'ASHLAR' {
                cpus             = 8
                memory           = '32 GB'
            }
            withName: 'TO_SPATIALDATA' {
                cpus             = 8
                memory           = '32 GB'
            }
            withName: 'MERGE_SPATIALDATA' {
                cpus             = 4
                memory           = '16 GB'
            }
        }
    }
}
