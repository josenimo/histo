/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    josenimo/histo Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null

    // Preprocessing options
    // true: one samplesheet row per cycle (raw tiles). false: one row per sample sopa can already read.
    // dfp/ffp are samplesheet columns, all-or-nothing per sample; omit both to compute profiles per cycle.
    use_preprocessing          = true
    ashlar_args                = '--maximum-shift 30'

    // Background subtraction needs exposure and background columns in the marker sheet.
    use_backsub                = false
    backsub_args               = ''

    // TMA dearray is the only step that changes cardinality: one slide becomes N core samples.
    use_tma_dearray            = false
    coreograph_args            = '--downsampleFactor 5 --channel 0 --buffer 2'

    // Ashlar -c and Coreograph --channel must point at a dna channel; true runs anyway, with a warning.
    skip_reference_dna_check   = false

    // Reader options
    technology                 = "ome_tif"

    // Patchify options
    patch_width_pixel          = null
    patch_overlap_pixel        = null
    image_scale                = null

    // Image preprocessing options
    gaussian_sigma             = null
    clip_limit                 = null
    clahe_kernel_size          = null

    // Tissue segmentation options
    use_tissue_segmentation    = false
    level                      = null
    mode                       = null
    tissue_segmentation_kwargs = null

    // Cellpose segmentation options
    use_cellpose               = false
    cellpose_diameter          = null
    cellpose_channels          = null
    flow_threshold             = null
    cellprob_threshold         = null
    cellpose_model_type        = null
    pretrained_model           = null
    cellpose_use_gpu           = false
    cellpose_kwargs            = null

    // Stardist segmentation options
    use_stardist               = false
    stardist_model_type        = null
    prob_thresh                = null
    nms_thresh                 = null
    stardist_channels          = null
    stardist_kwargs            = null

    // QC report options. Other QC tuning goes through ext.args in conf/modules.config, not params.
    use_qc                      = true
    // Clustering and image crops cost minutes; the metrics alone cost seconds.
    use_qc_images               = true

    // Fluorescence annotation options
    use_fluorescence_annotation = false
    fluorescence_cell_type_key  = null
    marker_cell_dict            = null

    // Cell filtering options
    // null min_area means no filtering: the sopa CLI defaults to 0 (the (diameter/2)^2 default is Python API only).
    // No global default: the floor is a scientific choice and varies with magnification; set it per profile.
    min_area_pixels2           = null
    min_transcripts            = null
    min_intensity_ratio        = null

    // Aggregation options
    aggregate_genes            = null
    aggregate_channels         = null
    expand_radius_ratio        = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    // Caps resource requests so stub runs fit a laptop (-profile laptop -stub).
    // Not for real work: the containers are amd64 only (CLAUDE.md section 5).
    laptop {
        process {
            resourceLimits = [
                cpus: 4,
                memory: '8.GB',
                time: '1.h',
            ]
            // ashlar and backsub eval() their versions even under -stub; tests/stub_bin holds version shims.
            beforeScript = "export PATH=${projectDir}/tests/stub_bin:\$PATH"
        }
    }
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694: arm64 needs wave for now
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    slurm         { includeConfig 'conf/slurm.config'         }

    test          { includeConfig 'conf/test.config'          }
    test_cellpose { includeConfig 'conf/test_cellpose.config' }
    test_cellpose_multi_patches { includeConfig 'conf/test_cellpose_multi_patches.config' }
    test_cellpose_CK_DAPI { includeConfig 'conf/test_cellpose_CK_DAPI.config' }
    test_full     { includeConfig 'conf/test_full.config'     }
    // The two pre-release checks, run by hand on the cluster. See ROADMAP.
    test_exemplar001 { includeConfig 'conf/test_exemplar001.config' }
    test_exemplar002 { includeConfig 'conf/test_exemplar002.config' }

    hyperion_base  { includeConfig 'conf/predefined/hyperion_base.config' }
    macsima_base  { includeConfig 'conf/predefined/macsima_base.config' }
    phenocycler_base_40X  { includeConfig 'conf/predefined/phenocycler_base_40X.config' }
    phenocycler_base_10X  { includeConfig 'conf/predefined/phenocycler_base_10X.config' }
    phenocycler_base_20X  { includeConfig 'conf/predefined/phenocycler_base_20X.config' }
}

// size_* profiles. Included at top level because the file declares its own profiles scope.
includeConfig 'conf/sizes.config'

// Load nf-core institutional profiles, skipped when NXF_OFFLINE is set and the base is remote.
// TODO: this launch-time network fetch conflicts with CLAUDE.md section 5; drop it or vendor a local config.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Default registry, used only when a container engine is enabled. Change it if you mirror containers.
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Stop host Python/R libraries leaking into the container.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    NUMBA_CACHE_DIR  = "/tmp/numba_cache_dir"
    MPLCONFIGDIR     = "/tmp/mplconfigdir"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
    // Record both request (cpus, memory, time) and usage (%cpu, peak_rss, realtime) to tune conf/sizes.config.
    fields  = 'task_id,hash,name,status,exit,attempt,cpus,memory,time,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'josenimo/histo'
    contributors    = [
        [
            name: 'Jose Nimo',
            affiliation: 'Max Delbrück Center for Molecular Medicine',
            email: 'jose.nimo@mdc-berlin.de',
            github: 'https://github.com/josenimo',
            contribution: ['author', 'maintainer'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: '' // TODO add ORCID
        ],
    ]
    homePage        = 'https://github.com/josenimo/histo'
    description     = """Processing, segmentation and quantification of multiplex immunofluorescence (mIF) images"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.4'
    version         = '1.1.0dev'
}

// Nextflow plugins
plugins {
    // Needs >=2.7.2: older versions ignore cast_cli_params, so CLI numbers and booleans fail as strings.
    id 'nf-schema@2.7.2' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
