{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/josenimo/histo/main/assets/schema_input.json",
    "title": "josenimo/histo pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name cannot contain spaces",
                "meta": ["sample"]
            },
            "id": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "ID cannot contain spaces",
                "meta": ["id"]
            },
            "data_path": {
                "type": "string",
                "pattern": "^\\S+$",
                "format": "path",
                "exists": true,
                "errorMessage": "Data path must exist and not contain spaces"
            }
        },
        "required": ["data_path"]
    }
}
